# Copy this file to ".env" (same folder as nina_advanced_mcp.py) and edit
# the values. The script loads it automatically via python-dotenv when you
# run it manually (e.g. for testing — see README §"Step 3 — Verify the
# server runs"). When the server is launched by an MCP client (Claude
# Desktop, NINA AI Assistant plugin), the client's own "env" block
# OVERRIDES anything in this file.
#
# DO NOT commit your .env to git — it's already in .gitignore.

# -----------------------------------------------------------------------------
# Where NINA + Advanced API plugin is reachable
# -----------------------------------------------------------------------------
# Same machine as this server  -> leave as "localhost"
# Observatory PC (separate machine on LAN) -> set to its IP, e.g. 192.168.1.42
NINA_HOST=localhost

# Port configured in the Advanced API plugin (default 1888)
NINA_PORT=1888

# -----------------------------------------------------------------------------
# Logging verbosity for the MCP server itself
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
# Use DEBUG only when chasing a bug — it's very chatty.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Where image-capture tools save FITS files
# -----------------------------------------------------------------------------
# Must be writable by the NINA process. The "~" expands to your home folder.
# Windows example: C:/Users/YourName/Pictures/NINA_AI_Captures
IMAGE_SAVE_DIR=~/Desktop/NINA_Images
