# Direct runtime dependencies. Edit this file, then regenerate the pinned set:
#
#     uv pip compile requirements.in --python-version 3.11 --output-file requirements.txt
#
# requirements.txt is what gets installed, and it pins every package including the
# transitive ones. Two machines installing on different days must get the same server.

# Pinned, not floated. The server is written against the fastmcp 1.x API and this is the
# version it has run on in the field; the resolver left free picks 3.x, which is three
# major versions of API change away and has never been tried here.
fastmcp==1.0

